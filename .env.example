# Copy to .env.local. Button links are not set here: each has its own tracked link in src/content/journeys.ts (D69).
# C1: the marketing domain is not confirmed (linkist.ai root or a subdomain). Placeholder until then.
NEXT_PUBLIC_SITE_URL=https://linkist.ai
# The PRM app. Sign in (footer and page not found) and the /sign-in redirect open its sign-in screen, /UnifiedAuth.
NEXT_PUBLIC_APP_URL=https://prm.linkist.ai
# Overrides that sign-in address.
# NEXT_PUBLIC_GET_APP_URL=https://prm.linkist.ai/UnifiedAuth
# The App Store and Google Play listings, once they exist (R3). Unset, the hero badges read "Coming soon" and do not link.
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=
# Where static assets such as OG images really live while the domain is a placeholder (Grownz D27).
# NEXT_PUBLIC_ASSET_URL=

# Screen captures (scripts/capture.ts). Sign in once by hand with pnpm capture:login; the session is kept locally.
CAPTURE_BASE_URL=https://prm.linkist.ai

# Forms (checkpoint 5). Unset means the routes answer 503 with an honest message.
# RESEND_API_KEY=
# LEAD_TO=
# LEAD_FROM=Linkist website <website@linkist.ai>
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Early access (D77, D79). Set EARLY_ACCESS_CLOSED=1 and redeploy once the 55 places are taken; the form also
# closes by itself after 31 December 2026 (Dubai). EARLY_ACCESS_FROM is the sender of the visitor's email.
# EARLY_ACCESS_CLOSED=
# EARLY_ACCESS_FROM=Linkist <hello@linkist.ai>
# Early access claims database (D90): Linkist's Supabase project, set up once with docs/early-access-claims.sql.
# A secret key (sb_secret_...) or the legacy service_role key; never a publishable one. Unset means claims go by
# email alone.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=

# Public contact addresses. Unset means the contact page says the address is published at launch.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@linkist.ai
# NEXT_PUBLIC_PARTNERSHIPS_EMAIL=
# NEXT_PUBLIC_SECURITY_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@linkist.ai

# Analytics and ads: the marketing team's Google Tag Manager container (GA4 and the Meta Pixel), started by the
# cookie notice and only on the live hosts (D75). Both have working defaults; set them only to test elsewhere.
# NEXT_PUBLIC_GTM_ID=GTM-P8RPQ6RG
# NEXT_PUBLIC_GTM_HOSTS=www.linkist.ai,linkist.ai

# Site assistant upgrade path (optional). Without it the assistant answers from the help corpus alone.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Theme: dark ships by default (brief, Design system). Set light to preview the backup theme.
# NEXT_PUBLIC_THEME=dark

# Pre-launch: set to true on a preview or on any deployment whose host is not the real domain. Every page
# then carries noindex and robots.txt disallows everything (D27). Leave unset for the launch deployment.
# NEXT_PUBLIC_NOINDEX=true
