# Copy to .env.local. Every URL on the site derives from these.
# C1: the marketing domain is not confirmed (linkist.ai root or a subdomain). Placeholder until then.
NEXT_PUBLIC_SITE_URL=https://linkist.ai
# The product. Start free and Sign in land here (brief, scope). The app signs in and registers on one screen at its root.
NEXT_PUBLIC_APP_URL=https://prm.linkist.ai
# Where static assets such as OG images really live while the domain is a placeholder (Grownz D27).
# NEXT_PUBLIC_ASSET_URL=

# Screen captures (scripts/capture.ts). Sign in once by hand with pnpm capture:login; the session is kept locally.
CAPTURE_BASE_URL=https://prm.linkist.ai

# Forms (checkpoint 5). Unset means the routes answer 503 with an honest message.
# RESEND_API_KEY=
# LEAD_TO=
# LEAD_FROM=Linkist website <website@linkist.ai>
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public contact addresses. Unset means the contact page says the address is published at launch.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@linkist.ai
# NEXT_PUBLIC_PARTNERSHIPS_EMAIL=
# NEXT_PUBLIC_SECURITY_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@linkist.ai

# Analytics: GA4 through the consent notice. No id, no script, no notice.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Site assistant upgrade path (optional). Without it the assistant answers from the help corpus alone.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Theme: dark ships by default (brief, Design system). Set light to preview the backup theme.
# NEXT_PUBLIC_THEME=dark

# Pre-launch: set to true on a preview or on any deployment whose host is not the real domain. Every page
# then carries noindex and robots.txt disallows everything (D27). Leave unset for the launch deployment.
# NEXT_PUBLIC_NOINDEX=true
